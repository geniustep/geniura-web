{
  "name": "geniura-web",
  "version": "0.1.0",
  "private": true,
  "description": "Geniura web front-end (Next.js). Django (geniura-api) remains the source of truth for data and permissions.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write features/profile/extraction-review.tsx features/profile/item-dialog.tsx features/profile/partial-date-field.tsx features/profile/partial-date.ts features/profile/sections.ts tests/unit/partial-date.test.ts && node -e 'const fs=require(\"node:fs\");for(const p of [\"features/profile/extraction-review.tsx\",\"features/profile/item-dialog.tsx\",\"features/profile/partial-date-field.tsx\",\"features/profile/partial-date.ts\",\"features/profile/sections.ts\",\"tests/unit/partial-date.test.ts\"]) console.log(\"FORMATTED_FILE \"+p+\" \"+fs.readFileSync(p).toString(\"base64\"));' && prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-logical-css.mjs",
    "check:messages": "node scripts/check-messages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:css && pnpm check:messages && pnpm test",
    "api:contract": "node scripts/contract/build-web-contract.mjs",
    "api:generate": "orval --config orval.config.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@date-fns/tz": "1.5.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "schema-dts": "2.1.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "21.0.3",
    "orval": "8.43.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
