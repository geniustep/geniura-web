# Copy to .env.local for local development. Never commit real values: this repository is public.

# Public origin of the web app (used for metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until a production launch is explicitly approved; robots.txt then disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Django API (geniura-api). The browser uses same-origin /api/bff; this is a server fallback.
# staging target: https://api-geniura.geniura.com (same registrable domain as geniura.com, ADR 0002).
# localhost is for explicit local development only; never use it in deployed previews.
NEXT_PUBLIC_API_BASE_URL=https://api-geniura.geniura.com
# Optional internal origin for server-side calls from Next.js; defaults to the public one.
API_BASE_URL=
