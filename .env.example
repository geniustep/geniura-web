# Copy to .env.local for local development. Never commit real values: this repository is public.

# Public origin of the web app (used for metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" until a production launch is explicitly approved; robots.txt then disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Django API (geniura-api). The browser calls NEXT_PUBLIC_API_BASE_URL with credentials;
# production target: https://api.geniura.com (same registrable domain as geniura.com, ADR 0002).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional internal origin for server-side calls from Next.js; defaults to the public one.
API_BASE_URL=
